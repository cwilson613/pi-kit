  "verify.release_verify": {
    "cmd": "omegon-maintain --json release verify \\\n  --archive /absolute/path/omegon-<version>-<target>.tar.gz \\\n  --manifest /absolute/path/omegon-<version>-<target>.tar.gz.manifest.json \\\n  --bundle /absolute/path/omegon-<version>-<target>.tar.gz.manifest.sigstore.json",
    "desc": "Verify a release package offline against compiled identity policy"
  },
  "verify.gh_attestation": {
    "cmd": "gh attestation verify omegon-*.tar.gz --repo styrene-lab/omegon",
    "desc": "Verify GitHub Attestations (build provenance)"
  }
